# Copy to .env. Keep credentials out of Git.
GOOGLE_API_KEY=
K8S_AGENT_MODEL=gemini-3.6-flash
# Google recommends 1.0 for Gemini 3; lower values can degrade reasoning.
K8S_AGENT_TEMPERATURE=1.0
# PostgreSQL A2A task and ADK session persistence. Set your local Docker password.
A2A_TASK_DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@127.0.0.1:5432/k8s_agent_tasks
K8S_AGENT_BASE_URL=http://localhost:8002
PORT=8002

# Streamable HTTP endpoint of a separately running Kubernetes MCP server.
K8S_MCP_URL=http://127.0.0.1:8083/mcp
# Optional bearer token if the MCP HTTP endpoint requires one.
K8S_MCP_TOKEN=
# Optional PEM CA file when the HTTPS MCP endpoint uses an internal CA.
K8S_MCP_CA_FILE=
